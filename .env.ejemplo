# ============================================================================
# PLANTILLA de configuración. Este archivo SÍ se sube a Git y NO contiene secretos.
# Para crear tu ".env" real con claves aleatorias, NO copies este archivo a mano:
#     Linux / macOS / Git Bash :  ./scripts/generar-env.sh
#     Windows (PowerShell)     :  .\scripts\generar-env.ps1
# El archivo ".env" que se genera está en .gitignore y jamás debe subirse a Git.
# ============================================================================

# --- Sesiones ---
# Clave con la que se firman los JWT. Mínimo 32 caracteres aleatorios.
JWT_SECRETO=CAMBIAR

# --- Administrador inicial (se crea al primer arranque) ---
ADMIN_CORREO=admin@bulkphish.test
ADMIN_NOMBRE=Administrador
# Mínimo 12 caracteres.
ADMIN_CLAVE=CAMBIAR

# --- Base de datos: una contraseña distinta por servicio ---
CLAVE_BD_ADMIN=CAMBIAR
CLAVE_BD_AUTENTICACION=CAMBIAR
CLAVE_BD_CAMPANAS=CAMBIAR
CLAVE_BD_RESULTADOS=CAMBIAR

# --- RabbitMQ ---
RABBIT_USUARIO=bulkphish
RABBIT_CLAVE=CAMBIAR

# --- Grafana (panel de observabilidad) ---
GRAFANA_USUARIO=admin
GRAFANA_CLAVE=CAMBIAR

# --- Red ---
# Dirección donde escucha el gateway. 127.0.0.1 = solo tu máquina (recomendado).
# Usa 0.0.0.0 únicamente si quieres abrirlo a tu red local.
BIND_GATEWAY=127.0.0.1
# Dirección base que llevan los enlaces de los correos simulados.
URL_PUBLICA=http://localhost:8080
